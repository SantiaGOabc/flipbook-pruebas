---
import { NAVIGATION } from '../../constants/header/navigation';
---

<header class="flex items-center justify-between w-full h-18 px-8 py-6 border-b border-white/10">
  <a href="/" class="flex items-center gap-2 text-xl font-semibold text-zinc-300">
    <img src="/images/logo_firma_mrv.png" alt="Logo" class="w-30 h-18 p-4 object-cover" />
  </a>
  <nav class="flex items-center gap-4" aria-label="Navegación principal">
    {
      NAVIGATION.map((item) => (
        <a href={item.href} class="text-sm font-medium text-zinc-200 hover:text-zinc-300 transition-colors">{item.label}</a>
      ))
    }
  </nav>
</header>
