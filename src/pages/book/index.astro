---
import '../../styles/global.css';
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Cochabamba - Flipbook</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body class="h-full overflow-hidden bg-black text-white font-sans antialiased">
    <main class="flex h-screen w-screen items-center
      bg-[radial-gradient(ellipse_at_15%_50%,rgba(88,28,135,0.15),transparent_50%),radial-gradient(ellipse_at_85%_50%,rgba(88,28,135,0.08),transparent_40%),linear-gradient(to_right,#0a0014,#050505_35%,#050505_65%,#0a0014)]">

      <div class="flex items-center w-full max-w-350 mx-auto px-[5%] gap-16">

        <!-- LADO IZQUIERDO -->
        <section class="flex-1 max-w-130" aria-label="Presentación de Cochabamba">
          <header class="mb-6">
            <span class="block text-[0.7rem] font-semibold tracking-[3px] uppercase text-purple-400 mb-3">Bolivia</span>
            <h1 class="text-[4rem] font-extrabold leading-none tracking-tight text-white mb-1">Cochabamba</h1>
            <p class="text-[1.1rem] font-normal text-zinc-400">La Ciudad de la Eterna Primavera</p>
          </header>

          <p class="text-[0.95rem] font-light leading-relaxed text-zinc-500 mb-5">
            Descubre la riqueza cultural, los sabores ancestrales y los paisajes
            que hacen de Cochabamba un destino único en el corazón de Sudamérica.
          </p>

          <ul class="flex gap-2 list-none mb-8">
            <li class="text-xs font-medium text-zinc-500 px-2.5 py-1 border border-zinc-800 rounded">2026</li>
            <li class="text-xs font-medium text-zinc-500 px-2.5 py-1 border border-zinc-800 rounded">Guía Turística</li>
            <li class="text-xs font-medium text-zinc-500 px-2.5 py-1 border border-zinc-800 rounded">Interactive</li>
          </ul>

          <nav class="flex gap-3 items-center" aria-label="Acciones principales">
            <a href="#experiencia"
              class="inline-flex items-center gap-2 px-7 py-3 bg-purple-600 text-white no-underline rounded-md text-[0.9rem] font-semibold transition-colors hover:bg-purple-700">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"/></svg>
              Iniciar la experiencia
            </a>
            <a href="#info"
              class="inline-flex items-center px-7 py-3 bg-white/8 text-zinc-300 no-underline rounded-md text-[0.9rem] font-medium border border-white/10 transition-colors hover:bg-white/[0.14]">
              Más información
            </a>
          </nav>
        </section>

        <!-- LADO DERECHO - LIBRO 3D -->
        <aside class="flex-1 flex justify-center items-center" aria-label="Libro ilustrativo">
          <div class="book-scene">
            <div class="book" role="img" aria-label="Libro 3D de Cochabamba">
              <div class="book-face book-front">
                <div class="cover-inner">
                  <div class="cover-rule"></div>
                  <span class="cover-category">Guía Turística</span>
                  <h2 class="cover-title">Cochabamba</h2>
                  <p class="cover-year">2026</p>
                  <div class="cover-rule"></div>
                </div>
              </div>
              <div class="book-face book-back"></div>
              <div class="book-stack">
                <span class="book-page"></span>
                <span class="book-page"></span>
                <span class="book-page"></span>
                <span class="book-page"></span>
              </div>
              <div class="book-spine"></div>
            </div>
          </div>
        </aside>

      </div>
    </main>
  </body>
</html>

