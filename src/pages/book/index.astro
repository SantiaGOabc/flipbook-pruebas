<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Cochabamba - Flipbook</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=Inter:wght@300;400;500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <main class="page">
      <section class="left" aria-label="Presentación de Cochabamba">
        <div class="left-content">
          <h1>Cochabamba</h1>
          <p class="tagline">La Ciudad de la Eterna Primavera</p>
          <p class="description">
            Descubre la riqueza cultural, los sabores ancestrales y los paisajes
            que hacen de Cochabamba un destino único en el corazón de Sudamérica.
          </p>
          <nav class="actions" aria-label="Acciones principales">
            <a href="#experiencia" class="btn-primary">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3"/></svg>
              Iniciar la experiencia
            </a>
          </nav>
        </div>
      </section>

      <section class="right" aria-label="Libro ilustrativo">
        <div class="book-scene">
          <div class="book" role="img" aria-label="Libro 3D de Cochabamba">
            <div class="book-cover book-front">
              <div class="cover-content">
                <div class="cover-line"></div>
                <span class="cover-label">Guía Turística</span>
                <h2 class="cover-title">Cochabamba</h2>
                <p class="cover-year">2026</p>
                <div class="cover-line"></div>
              </div>
            </div>
            <div class="book-cover book-back"></div>
            <div class="book-pages">
              <div class="page-item"></div>
              <div class="page-item"></div>
              <div class="page-item"></div>
              <div class="page-item"></div>
            </div>
            <div class="book-spine"></div>
          </div>
        </div>
      </section>
    </main>
  </body>
</html>

<style>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html, body {
    height: 100%;
    overflow: hidden;
    font-family: 'Inter', sans-serif;
    background: #0a0a0a;
    color: #ffffff;
  }

  /* ===== LAYOUT PRINCIPAL ===== */
  .page {
    display: flex;
    height: 100vh;
    width: 100vw;
    background: linear-gradient(to right, #1a0a2e 0%, #0d0d0d 40%, #0d0d0d 60%, #110720 85%, #0a0a0a 100%);
  }

  /* ===== LADO IZQUIERDO ===== */
  .left {
    width: 50%;
    display: flex;
    align-items: center;
    padding-left: 6%;
  }

  .left-content {
    max-width: 480px;
  }

  h1 {
    font-family: 'Playfair Display', serif;
    font-weight: 900;
    font-size: 4.5rem;
    line-height: 1;
    letter-spacing: -2px;
    color: #ffffff;
    margin-bottom: 0.4rem;
  }

  .tagline {
    font-size: 1.15rem;
    font-weight: 400;
    color: #b3b3b3;
    margin-bottom: 1.2rem;
  }

  .description {
    font-size: 0.9rem;
    font-weight: 400;
    line-height: 1.6;
    color: #999;
    margin-bottom: 2rem;
    max-width: 400px;
  }

  .actions {
    display: flex;
    gap: 12px;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 28px;
    background: #7c3aed;
    color: #fff;
    text-decoration: none;
    border-radius: 6px;
    font-size: 0.9rem;
    font-weight: 600;
    transition: background 0.2s ease;
  }

  .btn-primary:hover {
    background: #6d28d9;
  }

  .btn-primary svg {
    flex-shrink: 0;
  }



  /* ===== LADO DERECHO ===== */
  .right {
    width: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* ===== ESCENA DEL LIBRO ===== */
  .book-scene {
    perspective: 1200px;
  }

  /* ===== EL LIBRO ===== */
  .book {
    position: relative;
    width: 240px;
    height: 340px;
    transform-style: preserve-3d;
    transform: rotateY(-22deg) rotateX(4deg);
    transition: transform 0.6s ease;
  }

  .book:hover {
    transform: rotateY(-10deg) rotateX(2deg);
  }

  /* Portada frontal */
  .book-front {
    position: absolute;
    width: 100%;
    height: 100%;
    background: linear-gradient(145deg, #2d1054 0%, #1a0633 40%, #0f0318 100%);
    border: 1px solid rgba(168, 85, 247, 0.25);
    border-radius: 2px 12px 12px 2px;
    transform: translateZ(18px);
    backface-visibility: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow:
      0 0 40px rgba(124, 58, 237, 0.15),
      inset 0 0 60px rgba(0, 0, 0, 0.3);
  }

  .cover-content {
    text-align: center;
    padding: 2rem;
  }

  .cover-line {
    width: 50px;
    height: 1px;
    background: linear-gradient(90deg, transparent, #a855f7, transparent);
    margin: 0.8rem auto;
  }

  .cover-label {
    font-size: 0.55rem;
    letter-spacing: 4px;
    color: rgba(192, 132, 252, 0.6);
    text-transform: uppercase;
    display: block;
    margin-bottom: 0.3rem;
  }

  .cover-title {
    font-family: 'Playfair Display', serif;
    font-weight: 700;
    font-size: 1.8rem;
    color: #e9d5ff;
    letter-spacing: 1px;
  }

  .cover-year {
    font-size: 0.8rem;
    color: rgba(168, 85, 247, 0.5);
    letter-spacing: 6px;
    margin-top: 0.3rem;
  }

  /* Portada trasera */
  .book-back {
    position: absolute;
    width: 100%;
    height: 100%;
    background: #110720;
    border: 1px solid rgba(168, 85, 247, 0.1);
    border-radius: 2px 12px 12px 2px;
    transform: translateZ(-18px) rotateY(180deg);
    backface-visibility: hidden;
  }

  /* Páginas internas */
  .book-pages {
    position: absolute;
    top: 4px;
    right: 4px;
    width: 100%;
    height: calc(100% - 8px);
    transform-style: preserve-3d;
  }

  .page-item {
    position: absolute;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, #e8e0f0 0%, #f5f0fa 30%, #faf8fc 100%);
    border-radius: 1px 10px 10px 1px;
    border-left: 1px solid rgba(0, 0, 0, 0.08);
    box-shadow: 1px 0 3px rgba(0, 0, 0, 0.08);
  }

  .page-item:nth-child(1) { transform: translateZ(12px); }
  .page-item:nth-child(2) { transform: translateZ(6px); }
  .page-item:nth-child(3) { transform: translateZ(0px); }
  .page-item:nth-child(4) { transform: translateZ(-6px); }

  /* Lomo del libro */
  .book-spine {
    position: absolute;
    left: -1px;
    top: 0;
    width: 36px;
    height: 100%;
    background: linear-gradient(90deg, #1a0633, #2d1054);
    border-radius: 4px 0 0 4px;
    transform: rotateY(90deg) translateZ(-18px);
    transform-origin: left center;
    box-shadow: -2px 0 8px rgba(0, 0, 0, 0.4);
  }

  /* ===== RESPONSIVE ===== */
  @media (max-width: 900px) {
    .page {
      flex-direction: column;
    }

    .left, .right {
      width: 100%;
      height: 50vh;
    }

    h1 {
      font-size: 2.8rem;
    }

    .book {
      width: 180px;
      height: 260px;
    }
  }
</style>
