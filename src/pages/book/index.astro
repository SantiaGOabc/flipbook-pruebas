---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Cochabamba - Flipbook">
  <main class="flex h-[calc(100vh-4rem)] w-screen items-center bg-white">

    <div class="flex items-center w-full max-w-[1400px] mx-auto px-[5%] gap-16">

      <!-- LADO IZQUIERDO -->
      <section class="flex-1 max-w-[520px]" aria-label="Presentación de Cochabamba">
        <header class="mb-6">
          <span class="block text-[0.7rem] font-bold tracking-[5px] uppercase text-purple-400 mb-3">Bolivia</span>
          <h1 class="text-[4rem] font-extrabold leading-none tracking-tight text-purple-900 mb-3">Cochabamba</h1>
          <p class="text-[1.1rem] font-normal text-zinc-400">La Ciudad de la Eterna Primavera</p>
        </header>

        <p class="text-[0.95rem] font-light leading-relaxed text-zinc-500 mb-5">
          Descubre la riqueza cultural, los sabores ancestrales y los paisajes
          que hacen de Cochabamba un destino único en el corazón de Sudamérica.
        </p>

        <ul class="flex gap-2 list-none mb-8">
          <li class="text-xs font-medium text-zinc-500 px-2.5 py-1 border border-zinc-800 rounded">2026</li>
        </ul>

        <nav class="flex gap-3 items-center" aria-label="Acciones principales">
          <a href="#experiencia"
            class="inline-flex items-center gap-2 px-7 py-3 bg-purple-600 text-white no-underline rounded-md text-[0.9rem] font-semibold transition-colors hover:bg-purple-700">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"/></svg>
            Iniciar la experiencia
          </a>
          <a href="#info"
            class="inline-flex items-center px-7 py-3 bg-white/[0.08] text-zinc-300 no-underline rounded-md text-[0.9rem] font-medium border border-white/10 transition-colors hover:bg-white/[0.14]">
            Más información
          </a>
        </nav>
      </section>

      <!-- LADO DERECHO - LIBRO 3D -->
      <aside class="flex-1 flex justify-center items-center" aria-label="Libro ilustrativo">
        <div class="book-scene">
          <div class="book" role="img" aria-label="Libro 3D de Cochabamba">
            <div class="book-face book-front">
              <div class="cover-inner">
                <div class="cover-rule"></div>
                <span class="cover-category">La mejor ciudad de Bolivia</span>
                <h2 class="cover-title">Cochabamba</h2>
                <p class="cover-year">2026</p>
                <div class="cover-rule"></div>
              </div>
            </div>
            <div class="book-face book-back"></div>
            <div class="book-stack">
              <span class="book-page"></span>
              <span class="book-page"></span>
              <span class="book-page"></span>
              <span class="book-page"></span>
            </div>
            <div class="book-spine"></div>
          </div>
        </div>
      </aside>

    </div>
  </main>
</Layout>
